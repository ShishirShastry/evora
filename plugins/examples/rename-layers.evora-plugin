{
  "format": "evora-plugin",
  "formatVersion": 1,
  "manifest": {
    "id": "org.evora.rename-layers",
    "name": "Rename layers",
    "version": "1.0.0",
    "description": "Renames the selected layers in one go: a new name with a running number, the old name kept in it, or a word found and replaced.",
    "author": "Evora",
    "kind": "plugin",
    "api": 1,
    "permissions": [
      "read",
      "write",
      "ui"
    ],
    "commands": [
      {
        "id": "rename",
        "name": "Rename selected layers…"
      }
    ],
    "widgets": [],
    "main": "main.js",
    "ui": "ui.html"
  },
  "code": "// Rename layers: an example plugin with a window.\n// The window (ui.html) sends what to do; this code does it, as one undo step.\n\nevora.showUI({ width: 300, height: 196, title: 'Rename layers' });\n\nasync function sendSelection() {\n  const layers = await evora.getSelection();\n  evora.ui.postMessage({ type: 'selection', count: layers.length, first: layers[0] ? layers[0].name : '' });\n}\n\nevora.on('selectionchange', sendSelection);\nawait sendSelection();\n\n/** The new name of a layer: \"$&\" stands for its old name and \"$n\" for its number. */\nfunction newName(oldName, message, index) {\n  if (message.find) return oldName.split(message.find).join(message.replace);\n  return message.pattern.split('$n').join(String(message.start + index)).split('$&').join(oldName);\n}\n\nevora.on('message', async (message) => {\n  if (message.type === 'cancel') {\n    evora.closePlugin();\n    return;\n  }\n  if (message.type !== 'rename') return;\n  const layers = await evora.getSelection();\n  if (layers.length === 0) {\n    evora.notify('Select the layers to rename first.', { error: true });\n    return;\n  }\n  let renamed = 0;\n  // All of it is one step in the history, named after this plugin.\n  await evora.batch(async () => {\n    for (let i = 0; i < layers.length; i++) {\n      const name = newName(layers[i].name, message, i);\n      if (name && name !== layers[i].name) {\n        await evora.setProperties(layers[i].id, { name });\n        renamed++;\n      }\n    }\n  });\n  evora.notify(renamed === 0 ? 'No names changed.' : `Renamed ${renamed} layer${renamed === 1 ? '' : 's'}.`);\n  await sendSelection();\n});\n",
  "ui": "<style>\n  form { display: flex; flex-direction: column; gap: 10px; padding: 12px; }\n  .mode { display: flex; gap: 2px; padding: 2px; border-radius: 8px; background: var(--evora-field); }\n  .mode button { flex: 1; height: 24px; border: 0; border-radius: 6px; background: transparent; color: var(--evora-dim); font: inherit; cursor: pointer; }\n  .mode button[aria-pressed=\"true\"] { background: var(--evora-bg); color: var(--evora-text); box-shadow: 0 0 0 1px var(--evora-line); }\n  label { display: flex; flex-direction: column; gap: 4px; color: var(--evora-dim); }\n  input { height: 28px; padding: 0 8px; border: 1px solid var(--evora-line); border-radius: 6px; background: var(--evora-field); color: var(--evora-text); font: inherit; }\n  input:focus { outline: 2px solid var(--evora-accent); outline-offset: -1px; }\n  .row { display: flex; gap: 8px; }\n  .row label { flex: 1; min-width: 0; }\n  .hint, .count { margin: 0; color: var(--evora-dim); }\n  .actions { display: flex; justify-content: flex-end; gap: 8px; }\n  .actions button { height: 28px; padding: 0 12px; border-radius: 6px; border: 1px solid var(--evora-line); background: var(--evora-field); color: var(--evora-text); font: inherit; cursor: pointer; }\n  .actions button.primary { border-color: transparent; background: var(--evora-accent); color: #fff; }\n  .actions button:disabled { opacity: 0.5; cursor: default; }\n  [hidden] { display: none !important; }\n</style>\n<form id=\"form\">\n  <div class=\"mode\" role=\"group\" aria-label=\"Mode\">\n    <button type=\"button\" id=\"mode-rename\" aria-pressed=\"true\">Rename</button>\n    <button type=\"button\" id=\"mode-replace\" aria-pressed=\"false\">Find and replace</button>\n  </div>\n  <div id=\"rename\">\n    <div class=\"row\">\n      <label>New name<input id=\"pattern\" value=\"Layer $n\" aria-label=\"New name\"></label>\n      <label style=\"flex: 0 0 64px\">From<input id=\"start\" type=\"number\" value=\"1\" aria-label=\"Start number\"></label>\n    </div>\n    <p class=\"hint\">$n is the layer's number, $&amp; its current name.</p>\n  </div>\n  <div id=\"replace\" class=\"row\" hidden>\n    <label>Find<input id=\"find\" aria-label=\"Find\"></label>\n    <label>Replace with<input id=\"with\" aria-label=\"Replace with\"></label>\n  </div>\n  <p class=\"count\" id=\"count\" aria-live=\"polite\">No layers selected</p>\n  <div class=\"actions\">\n    <button type=\"button\" id=\"cancel\">Close</button>\n    <button type=\"submit\" class=\"primary\" id=\"apply\" disabled>Rename</button>\n  </div>\n</form>\n<script>\n  const $ = (id) => document.getElementById(id);\n  let mode = 'rename';\n  let count = 0;\n  const send = (message) => parent.postMessage({ pluginMessage: message }, '*');\n  const update = () => {\n    $('mode-rename').setAttribute('aria-pressed', String(mode === 'rename'));\n    $('mode-replace').setAttribute('aria-pressed', String(mode === 'replace'));\n    $('rename').hidden = mode !== 'rename';\n    $('replace').hidden = mode !== 'replace';\n    $('apply').disabled = count === 0 || (mode === 'replace' && !$('find').value);\n    $('count').textContent = count === 0 ? 'No layers selected' : `${count} layer${count === 1 ? '' : 's'} selected`;\n  };\n  $('mode-rename').onclick = () => { mode = 'rename'; update(); };\n  $('mode-replace').onclick = () => { mode = 'replace'; update(); };\n  $('find').oninput = update;\n  $('cancel').onclick = () => send({ type: 'cancel' });\n  $('form').onsubmit = (event) => {\n    event.preventDefault();\n    if (mode === 'rename') send({ type: 'rename', pattern: $('pattern').value, start: Number($('start').value) || 0 });\n    else send({ type: 'rename', find: $('find').value, replace: $('with').value });\n  };\n  window.onmessage = (event) => {\n    const message = event.data && event.data.pluginMessage;\n    if (message && message.type === 'selection') {\n      count = message.count;\n      update();\n    }\n  };\n  update();\n</script>\n"
}
