{
  "name": "evora",
  "version": "0.2.0",
  "private": true,
  "description": "Evora - a free, open-source, local-first design and prototyping application.",
  "author": {
    "name": "Evora contributors"
  },
  "homepage": "https://github.com/ShishirShastry/evora",
  "main": "dist-electron/electron/main.js",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p electron/tsconfig.json && tsc --noEmit -p mcp/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test",
    "server": "node server/main.ts",
    "start": "npm run build && node server/main.ts --serve dist",
    "desktop": "node electron/dev.mjs",
    "desktop:build": "npm run build && tsc -p electron/tsconfig.json",
    "dist:desktop": "npm run desktop:build && electron-builder",
    "e2e:desktop": "playwright test -c e2e/desktop.config.ts",
    "desktop:icons": "electron electron/make-icons.mjs",
    "backup": "node server/backup.ts",
    "mcp:build": "vite build -c mcp/vite.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "electron-updater": "^6.8.11",
    "fractional-indexing": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "org.evora.app",
    "productName": "Evora",
    "executableName": "Evora",
    "copyright": "Copyright (c) 2026 Evora contributors. MIT licence.",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "dist/**/*",
      "dist-electron/**/*",
      "server/**/*.ts",
      "!server/**/*.test.ts",
      "!server/testing.ts",
      "src/collab/protocol.ts",
      "src/plugins/manifest.ts",
      "build/icon.png",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/{react,react-dom,scheduler,zustand,fractional-indexing,@fontsource}/**/*"
    ],
    "asarUnpack": [
      "dist/**/*",
      "server/**/*",
      "src/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "evora",
        "name": "Evora design",
        "description": "Evora design file",
        "mimeType": "application/x-evora",
        "role": "Editor"
      },
      {
        "ext": "opendesign",
        "name": "Evora design (older)",
        "description": "Evora design file (before the rename)",
        "role": "Editor"
      },
      {
        "ext": "fig",
        "name": "Figma file",
        "description": "Figma design file",
        "mimeType": "application/x-figma",
        "role": "Editor"
      }
    ],
    "protocols": [
      {
        "name": "Evora sign-in",
        "schemes": [
          "evora"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Evora",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Evora-Setup-${version}.${ext}",
      "license": "LICENSE"
    },
    "portable": {
      "artifactName": "Evora-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "Evora-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Evora-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Graphics",
      "synopsis": "Free, open-source, local-first design tool",
      "description": "Evora - a free, open-source, local-first design and prototyping application.",
      "maintainer": "Evora contributors <noreply@github.com>",
      "artifactName": "Evora-${version}-${arch}.${ext}",
      "mimeTypes": [
        "application/x-evora",
        "application/x-figma"
      ]
    },
    "deb": {
      "artifactName": "evora_${version}_${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ShishirShastry",
        "repo": "evora",
        "releaseType": "draft"
      }
    ]
  }
}
